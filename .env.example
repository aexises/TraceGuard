GEMINI_API_KEY=
GEMINI_BASE_URL=https://open.blackroute.space/v1
# auto selects OpenAI-compatible transport when GEMINI_BASE_URL is set.
TRACEGUARD_GEMINI_TRANSPORT=auto
TRACEGUARD_GEMINI_MODEL=gemini-3.5-flash
TRACEGUARD_OLLAMA_MODEL=qwen3:4b
# Low-memory fallback for the local supervisor: qwen3:1.7b
TRACEGUARD_OLLAMA_URL=http://127.0.0.1:11434
LOCAL_LLM_PORT=11434
TRACEGUARD_AGENTDOJO_MODEL_ID=qwen3:4b
TRACEGUARD_AGENTDOJO_FALLBACK_MODEL_ID=qwen3:1.7b
TRACEGUARD_AGENTDOJO_SUPERVISOR_MODEL=qwen3:4b
# Must include @sha256:<digest>; choose an ARM64-compatible image.
TRACEGUARD_SANDBOX_IMAGE=
